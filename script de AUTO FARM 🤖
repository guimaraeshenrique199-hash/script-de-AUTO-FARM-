-- VALIDAR JOGADOR
local function valido(p)
    if not p or p == LocalPlayer then
        return false
    end

    local char = p.Character
    if not char then
        return false
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    return hum ~= nil and root ~= nil and hum.Health > 0
end

-- JOGADOR MAIS PRÓXIMO
local function maisProximo()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local escolhido = nil
    local menor = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if valido(p) then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local d = (root.Position - r.Position).Magnitude
                if d < menor then
                    menor = d
                    escolhido = p
                end
            end
        end
    end

    return escolhido
end

-- ESCOLHER ALVO ALEATÓRIO
local function aleatorioJogador()
    local candidatos = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if valido(p) and p ~= alvo then
            table.insert(candidatos, p)
        end
    end

    if #candidatos == 0 then
        return maisProximo()
    end

    return candidatos[math.random(1, #candidatos)]
end

-- LIMPAR ESTABILIZAÇÃO
local function limparEstabilizacao()
    if heartbeatConnection then
        heartbeatConnection:Disconnect()
        heartbeatConnection = nil
    end

    if alignPosition then
        alignPosition:Destroy()
        alignPosition = nil
    end

    if alignOrientation then
        alignOrientation:Destroy()
        alignOrientation = nil
    end

    if attachment0 then
        attachment0:Destroy()
        attachment0 = nil
    end
end

-- OBSERVAR MORTE DO ALVO
local observarMorte

observarMorte = function()
    if morteConnection then
        morteConnection:Disconnect()
        morteConnection = nil
    end

    if not alvo then return end

    local char = alvo.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    morteConnection = hum.Died:Connect(function()
        if not ativo or not aleatorio then return end

        task.wait(0.2)
        if not ativo then return end

        alvo = aleatorioJogador()

        if alvo then
            atualizarAlvo()
            observarMorte()
        end
    end)
end

-- INICIAR ESTABILIZAÇÃO
local function iniciarEstabilizacao()
    limparEstabilizacao()

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    if ANGULO == "pes" then
        ativarModoPes(char)
    end

    attachment0 = Instance.new("Attachment")
    attachment0.Name = "HenriqueStableAttachment"
    attachment0.Parent = root

    alignPosition = Instance.new("AlignPosition")
    alignPosition.Name = "HenriqueStablePosition"
    alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
    alignPosition.Attachment0 = attachment0
    alignPosition.ApplyAtCenterOfMass = true
    alignPosition.MaxForce = 1000000
    alignPosition.MaxVelocity = 800
    alignPosition.Responsiveness = 100
    alignPosition.RigidityEnabled = false
    alignPosition.Position = root.Position
    alignPosition.Parent = root

    alignOrientation = Instance.new("AlignOrientation")
    alignOrientation.Name = "HenriqueStableOrientation"
    alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOrientation.Attachment0 = attachment0
    alignOrientation.MaxTorque = 1000000
    alignOrientation.Responsiveness = 50
    alignOrientation.RigidityEnabled = false
    alignOrientation.CFrame = root.CFrame.Rotation
    alignOrientation.Parent = root

    heartbeatConnection = RunService.Heartbeat:Connect(function()
        if not ativo then return end

        local personagemAtual = LocalPlayer.Character

        if ANGULO == "pes" then
            -- Reaplica o NoClip continuamente enquanto Pés estiver ativo.
            -- Isso também inclui partes que forem adicionadas depois.
            if personagemAtual then
                ativarModoPes(personagemAtual)
            end
        elseif personagemPes then
            restaurarColisoes()
        end

        if not valido(alvo) then
            if aleatorio then
                alvo = aleatorioJogador()
                if alvo then
                    atualizarAlvo()
                    observarMorte()
                end
            end
            return
        end

        local targetChar = alvo.Character
        local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        local targetHead = targetChar and targetChar:FindFirstChild("Head")
        if not targetRoot or not targetHead then return end

        local posicao
        local orientacao

        if ANGULO == "cabeça" then
            posicao = targetHead.Position + Vector3.new(0, ALTURA, 0)
            orientacao = CFrame.Angles(math.rad(-90), 0, 0)

        elseif ANGULO == "costas" then
            posicao = targetRoot.Position
                - targetRoot.CFrame.LookVector * DISTANCIA_COSTAS

            local olhar = Vector3.new(
                targetRoot.Position.X,
                posicao.Y,
                targetRoot.Position.Z
            )

            if (olhar - posicao).Magnitude > 0.01 then
                orientacao = CFrame.lookAt(posicao, olhar).Rotation
            else
                orientacao = targetRoot.CFrame.Rotation
            end

        else
            -- Posição abaixo do alvo
            posicao = targetRoot.Position
                - Vector3.new(0, PROFUNDIDADE_PES, 0)

            orientacao = CFrame.Angles(math.rad(90), 0, 0)
        end

        if alignPosition and alignPosition.Parent then
            alignPosition.Position = posicao
        end

        if alignOrientation and alignOrientation.Parent then
            alignOrientation.CFrame = orientacao
        end
    end)

    return true
end

-- DESLIGAR
local function desligar()
    ativo = false

    if seguirConnection then
        seguirConnection:Disconnect()
        seguirConnection = nil
    end

    if morteConnection then
        morteConnection:Disconnect()
        morteConnection = nil
    end

    limparEstabilizacao()
    restaurarColisoes()

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if hum then
        hum.AutoRotate = true
    end

    toggle.Text = "OFF❌"
    toggle.BackgroundColor3 = Color3.fromRGB(210,45,45)
end

-- LIGAR
local function ligar()
    if ativo then return end

    if aleatorio then
        alvo = aleatorioJogador()
    elseif not valido(alvo) then
        alvo = maisProximo()
    end

    if not alvo then
        toggle.Text = "🚫SEM ALVO🚫"

        task.delay(1, function()
            if not ativo then
                toggle.Text = "OFF❌"
            end
        end)

        return
    end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not iniciarEstabilizacao() then
        toggle.Text = "OFF❌"
        return
    end

    ativo = true

    if hum then
        hum.AutoRotate = false
    end

    toggle.Text = "ON✅"
    toggle.BackgroundColor3 = Color3.fromRGB(45,200,80)

    atualizarAlvo()
    observarMorte()
end

-- ON/OFF
toggle.Activated:Connect(function()
    if ativo then
        desligar()
    else
        ligar()
    end
end)


UserInputService.InputChanged:Connect(function(input)
    if not arrastando or not inicioToque or not inicioPosicao then
        return
    end

    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement then

        local delta = input.Position - inicioToque

        local function mover(obj, extraY, extraX)
            obj.Position = UDim2.new(
                inicioPosicao.X.Scale,
                inicioPosicao.X.Offset + delta.X + (extraX or 0),
                inicioPosicao.Y.Scale,
                inicioPosicao.Y.Offset + delta.Y + extraY
            )
        end

        mover(painel, -135, -7)
        mover(toggle, 0)
        mover(playersText, -40)
        mover(targetButton, 58)
        mover(anguloButton, 108)
        mover(lista, 158, -50)
        mover(serverButton, -87)
        mover(dragButton, -129)
    end
end)

UserInputService.InputEnded:Connect(function(input)

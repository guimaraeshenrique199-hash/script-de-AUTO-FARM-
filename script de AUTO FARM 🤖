-- ATUALIZAR LISTA
local function atualizarLista()

	for _,obj in ipairs(lista:GetChildren()) do
		if obj:IsA("TextButton") then
			obj:Destroy()
		end
	end

	local randomButton = Instance.new("TextButton")
	randomButton.Size = UDim2.new(1,-10,0,38)
	randomButton.BackgroundColor3 = Color3.fromRGB(80,80,90)
	randomButton.TextColor3 = Color3.new(1,1,1)
	randomButton.Text = "❓️ALEATÓRIO❓️"
	randomButton.TextScaled = true
	randomButton.Font = Enum.Font.GothamBold
	randomButton.BorderSizePixel = 0
	randomButton.ZIndex = 2
	randomButton.Parent = lista

	randomButton.Activated:Connect(function()
		aleatorio = true
		alvo = nil
		atualizarAlvo()
		lista.Visible = false
	end)

	for _,p in ipairs(Players:GetPlayers()) do

		if p ~= LocalPlayer then

			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1,-10,0,38)
			b.BackgroundColor3 = Color3.fromRGB(55,55,65)
			b.TextColor3 = Color3.new(1,1,1)
			b.Text = p.Name
			b.TextScaled = true
			b.Font = Enum.Font.GothamBold
			b.BorderSizePixel = 0
			b.ZIndex = 2
			b.Parent = lista

			b.Activated:Connect(function()

				aleatorio = false
				alvo = p

				atualizarAlvo()
				lista.Visible = false

				if ativo then
					observarMorte()
				end
			end)
		end
	end

	task.defer(function()
		lista.CanvasSize = UDim2.new(
			0,0,0,layout.AbsoluteContentSize.Y+10
		)
	end)
end

Players.PlayerAdded:Connect(function()
	task.wait(0.2)
	atualizarLista()
	atualizarPlayers()
end)

Players.PlayerRemoving:Connect(function(p)

	if alvo == p then

		if aleatorio and ativo then
			alvo = maisProximo()

			if alvo then
				atualizarAlvo()
				observarMorte()
			end
		else
			alvo = nil
			atualizarAlvo()
		end
	end

	atualizarLista()
	atualizarPlayers()
end)

atualizarLista()


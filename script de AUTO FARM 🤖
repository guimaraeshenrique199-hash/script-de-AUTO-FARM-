-- CONTROLE DAS COLISÕES NO MODO PÉS / NOCLIP
local colisaoOriginal = {}
local personagemPes = nil

local function restaurarColisoes()
    for parte, valor in pairs(colisaoOriginal) do
        if parte and parte.Parent then
            parte.CanCollide = valor
        end
    end

    table.clear(colisaoOriginal)
    personagemPes = nil
end

local function ativarModoPes(char)
    if not char then return end

    if personagemPes ~= char then
        restaurarColisoes()
        personagemPes = char
    end

    -- Desativa colisão em todas as partes atuais do personagem.
    for _, parte in ipairs(char:GetDescendants()) do
        if parte:IsA("BasePart") then
            if colisaoOriginal[parte] == nil then
                colisaoOriginal[parte] = parte.CanCollide
            end

            parte.CanCollide = false
        end
    end
end


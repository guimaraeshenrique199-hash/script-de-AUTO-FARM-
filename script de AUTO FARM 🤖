-- ARRASTAR TODO O GUI PELO BOTÃO
local arrastando = false
local inicioToque
local inicioPosicao

dragButton.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		arrastando = true
		inicioToque = input.Position
		inicioPosicao = toggle.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if not arrastando then return end

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement then

		local delta = input.Position - inicioToque

		toggle.Position = UDim2.new(
			inicioPosicao.X.Scale,
			inicioPosicao.X.Offset + delta.X,
			inicioPosicao.Y.Scale,
			inicioPosicao.Y.Offset + delta.Y
		)

		playersText.Position = UDim2.new(
			inicioPosicao.X.Scale,
			inicioPosicao.X.Offset + delta.X,
			inicioPosicao.Y.Scale,
			inicioPosicao.Y.Offset + delta.Y - 40
		)

		targetButton.Position = UDim2.new(
			inicioPosicao.X.Scale,
			inicioPosicao.X.Offset + delta.X,
			inicioPosicao.Y.Scale,
			inicioPosicao.Y.Offset + delta.Y + 58
		)

		lista.Position = UDim2.new(
			inicioPosicao.X.Scale,
			inicioPosicao.X.Offset + delta.X - 50,
			inicioPosicao.Y.Scale,
			inicioPosicao.Y.Offset + delta.Y + 108
		)

		serverButton.Position = UDim2.new(
			inicioPosicao.X.Scale,
			inicioPosicao.X.Offset + delta.X,
			inicioPosicao.Y.Scale,
			inicioPosicao.Y.Offset + delta.Y - 87
		)

		dragButton.Position = UDim2.new(
			inicioPosicao.X.Scale,
			inicioPosicao.X.Offset + delta.X,
			inicioPosicao.Y.Scale,
			inicioPosicao.Y.Offset + delta.Y - 129
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		arrastando = false
	end
end)


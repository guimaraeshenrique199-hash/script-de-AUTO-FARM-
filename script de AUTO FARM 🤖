-- VARIÁVEIS
local ativo = false
local alvo = nil
local aleatorio = false
local seguirConnection = nil
local morteConnection = nil

local function atualizarAlvo()
	if aleatorio then
		targetButton.Text = "ALVO🎯: ❓️ALEATÓRIO❓️"
	elseif alvo then
		targetButton.Text = "ALVO🎯: "..alvo.Name
	else
		targetButton.Text = "ALVO🎯"
	end
end

local function valido(p)
	if not p or p == LocalPlayer then return false end

	local char = p.Character
	if not char then return false end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")

	return hum and root and hum.Health > 0
end

local function maisProximo()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if not root then return nil end

	local escolhido
	local menor = math.huge

	for _,p in ipairs(Players:GetPlayers()) do
		if valido(p) then
			local r = p.Character:FindFirstChild("HumanoidRootPart")

			if r then
				local d = (root.Position-r.Position).Magnitude

				if d < menor then
					menor = d
					escolhido = p
				end
			end
		end
	end

	return escolhido
end

local function aleatorioJogador()
	local candidatos = {}

	for _,p in ipairs(Players:GetPlayers()) do
		if valido(p) and p ~= alvo then
			table.insert(candidatos,p)
		end
	end

	if #candidatos == 0 then
		return maisProximo()
	end

	return candidatos[math.random(1,#candidatos)]
end

local function observarMorte()

	if morteConnection then
		morteConnection:Disconnect()
	end

	if not alvo then return end

	local char = alvo.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if not hum then return end

	morteConnection = hum.Died:Connect(function()

		if not ativo or not aleatorio then return end

		task.wait(0.2)

		if not ativo then return end

		alvo = maisProximo()

		if not alvo then
			alvo = aleatorioJogador()
		end

		if alvo then
			atualizarAlvo()
			observarMorte()
		end
	end)
end

-- DESLIGAR
local function desligar()

	ativo = false

	if seguirConnection then
		seguirConnection:Disconnect()
		seguirConnection = nil
	end

	if morteConnection then
		morteConnection:Disconnect()
		morteConnection = nil
	end

	local meuChar = LocalPlayer.Character
	local meuRoot = meuChar and meuChar:FindFirstChild("HumanoidRootPart")

	local alvoChar = alvo and alvo.Character
	local alvoRoot = alvoChar and alvoChar:FindFirstChild("HumanoidRootPart")

	if meuRoot and alvoRoot then
		meuRoot.CFrame = alvoRoot.CFrame * CFrame.new(DISTANCIA_LADO,0,0)
	end

	local hum = meuChar and meuChar:FindFirstChildOfClass("Humanoid")

	if hum then
		hum.AutoRotate = true
	end

	toggle.Text = "OFF❌"
	toggle.BackgroundColor3 = Color3.fromRGB(210,45,45)
end

-- LIGAR
local function ligar()

	if aleatorio then
		alvo = aleatorioJogador()
	elseif not valido(alvo) then
		alvo = maisProximo()
	end

	if not alvo then
		toggle.Text = "🤷SEM ALVO🚫"

		task.delay(1,function()
			if not ativo then
				toggle.Text = "OFF❌"
			end
		end)

		return
	end

	ativo = true

	toggle.Text = "ON✅"
	toggle.BackgroundColor3 = Color3.fromRGB(45,200,80)

	atualizarAlvo()
	observarMorte()

	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if hum then
		hum.AutoRotate = false
	end

	seguirConnection = RunService.RenderStepped:Connect(function()

		if not ativo then return end

		if not valido(alvo) then

			if aleatorio then
				alvo = maisProximo()

				if alvo then
					atualizarAlvo()
					observarMorte()
				end
			end

			return
		end

		local meuChar = LocalPlayer.Character
		local alvoChar = alvo.Character

		if not meuChar or not alvoChar then return end

		local meuRoot = meuChar:FindFirstChild("HumanoidRootPart")
		local alvoHead = alvoChar:FindFirstChild("Head")

		if not meuRoot or not alvoHead then return end

		local posicao =
			alvoHead.Position + Vector3.new(0,ALTURA,0)

		meuRoot.CFrame =
			CFrame.new(posicao) *
			CFrame.Angles(math.rad(-90),0,0)

		meuRoot.AssemblyLinearVelocity = Vector3.zero
		meuRoot.AssemblyAngularVelocity = Vector3.zero
	end)
end

-- ON✅️/OFF❌️
toggle.Activated:Connect(function()
	if ativo then
		desligar()
	else
		ligar()
	end
end)

